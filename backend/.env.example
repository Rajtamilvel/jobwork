# ========================================================
# Supabase Configuration
# ========================================================

# Method 1: API Keys (Recommended — No database password needed!)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Method 2: Direct PostgreSQL (Optional)
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
